# Template for ~/.zshrc.secrets, which ~/.zshrc sources if it exists.
#
# The real file is chmod 600 and MUST NOT be committed -- .gitignore blocks
# *.secrets, so this .example is the only version that belongs in the repo.
# Values below are intentionally empty.

# LLM provider API keys
export XAI_API_KEY=''
export OPENROUTER_API_KEY=''

# Hugging Face
export HF_TOKEN=''

# Claude / Anthropic
# commented off to not interfere with sub login
# export CLAUDE_CODE_OAUTH_TOKEN=''
# export ANTHROPIC_OAUTH_TOKEN="$CLAUDE_CODE_OAUTH_TOKEN"

# Bitwarden (work)
export BW_USERNAME=''
export BW_PASSWORD=''
export BW_CLIENTID=''
export BW_CLIENTSECRET=''
